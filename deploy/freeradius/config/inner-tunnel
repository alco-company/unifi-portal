# Inner tunnel virtual server for TTLS/PEAP
server inner-tunnel {
    listen {
        ipaddr = 127.0.0.1
        port = 18120
        type = auth
    }

    authorize {
        preprocess
        # files # disable: DEFAULT rules are forcing Reject
        rest
        if (ok || updated) {
            update control {
                Auth-Type := Accept
            }
        } else {
            reject
        }
        eap {
            ok = return
        }
        pap
        chap
        mschap
    }

    authenticate {
        Auth-Type PAP {
            pap
        }
        Auth-Type CHAP {
            chap
        }
        Auth-Type MS-CHAP {
            mschap
        }
        eap
        pap
        chap
        mschap
    }

    session {
    }

    post-auth {
    }

    pre-proxy {
    }

    post-proxy {
    }
}
