eap {
    default_eap_type = md5
    timer_expire = 60
    ignore_unknown_eap_types = no
    cisco_accounting_username_bug = no
    max_sessions = 16384

    # MD5 authentication (simple, no TLS required)
    md5 {
    }

    # GTC authentication
    gtc {
        auth_type = PAP
    }

    # MS-CHAPv2 for basic authentication
    mschapv2 {
        send_error = no
        with_ntdomain_hack = no
    }
}
