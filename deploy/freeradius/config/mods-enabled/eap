eap {
    default_eap_type = ttls
    timer_expire = 60
    ignore_unknown_eap_types = no
    cisco_accounting_username_bug = no
    max_sessions = 16384

    # MD5 authentication (fallback)
    md5 {
    }

    # GTC authentication
    gtc {
        auth_type = PAP
    }

    # MS-CHAPv2 for PEAP inner authentication
    mschapv2 {
        send_error = no
        with_ntdomain_hack = no
    }

    # PEAP (Protected EAP) - most common for WiFi
    peap {
        tls = tls-common
        default_eap_type = mschapv2
        copy_request_to_tunnel = no
        use_tunneled_reply = no
        virtual_server = "inner-tunnel"
        soh = no
        require_client_cert = no
    }

    # TTLS (Tunneled TLS) - alternative for mobile devices
    ttls {
        tls = tls-common
        default_eap_type = pap
        copy_request_to_tunnel = no
        use_tunneled_reply = no
        virtual_server = "inner-tunnel"
        include_length = yes
        require_client_cert = no
    }

    # Proper TLS configuration with CA + Server certificate chain from kamal-proxy
    tls-config tls-common {
        private_key_password = ""
        # Use extracted certificate files from kamal-proxy Let's Encrypt certificates
        private_key_file = /etc/ssl/radius/server.key
        certificate_file = /etc/ssl/radius/server.crt
        ca_file = /etc/ssl/radius/ca.pem
        ca_path = /etc/ssl/certs
        cipher_list = "HIGH:!aNULL:!MD5:!DSS"
        cipher_server_preference = no
        ecdh_curve = "prime256v1"
        tls_max_version = "1.3"
        tls_min_version = "1.2"
        
        cache {
            enable = yes
            lifetime = 24
            max_entries = 255
        }
        
        verify {
            skip_if_ocsp_ok = no
            tmpdir = /tmp/radiusd
            client = "/usr/bin/openssl verify -CApath /etc/ssl/certs %{TLS-Client-Cert-Filename}"
        }
        
        ocsp {
            enable = no
            override_cert_url = no
            timeout = 0
            softfail = yes
        }
    }
}
